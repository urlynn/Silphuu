#!/sbin/openrc-run

name="Silphuu Blog"
description="Silphuu Go Server"

# supervise-daemon, not command_background: it keeps the process in the foreground, watches it
# and restarts it when it dies. The engine never daemonises itself, so the background form
# leaves the supervisor watching nothing.
supervisor="supervise-daemon"

command="/usr/local/bin/silphuu"

# The engine resolves src/, templates/ and its shipped config/ relative to the working
# directory, so this has to be the directory that holds server/.
directory="/usr/local/lib/silphuu/server"

pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.err"

# A start that fails immediately would otherwise respawn in a tight loop. supervise-daemon
# gives up after respawn_max attempts (10 by default).
respawn_delay=5

# Paths, identity, sync settings and credentials come from /etc/conf.d/silphuu. Every value
# that differs between deployments is in that file, so this script is the same on all of them.

depend() {
    need net
    before nginx
}
